# PR checks: pre-commit, unit tests, KFP compile.
# Triggered by terraform google_cloudbuild_trigger.pr

substitutions:
  _PYTHON_VERSION: "{{ python_version }}"

options:
  logging: CLOUD_LOGGING_ONLY

steps:
  - name: "python:${_PYTHON_VERSION}"
    id: "pr-checks"
    entrypoint: bash
    args:
      - -c
      - |
        set -euo pipefail
        python -m pip install --upgrade pip
        pip install -e ".[dev]"
        pip install pre-commit

        echo "==> pre-commit"
        pre-commit run --all-files --show-diff-on-failure

        echo "==> unit tests"
        pytest -q

        echo "==> KFP compile"
        mkdir -p artifacts
        python -m {{ package_name }}.pipelines.training artifacts/training_pipeline.yaml
        python -m {{ package_name }}.pipelines.prediction artifacts/prediction_pipeline.yaml
        test -s artifacts/training_pipeline.yaml
        test -s artifacts/prediction_pipeline.yaml
        echo "Compiled KFP artifacts OK"

timeout: 1200s
