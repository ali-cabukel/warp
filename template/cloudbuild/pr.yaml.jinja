# PR checks: pre-commit, unit tests, KFP compile (Poetry).
# Triggered by terraform google_cloudbuild_trigger.pr

substitutions:
  _PYTHON_VERSION: "{{ python_version }}"
  _POETRY_VERSION: "2.1.4"

options:
  logging: CLOUD_LOGGING_ONLY

steps:
  - name: "python:${_PYTHON_VERSION}"
    id: "pr-checks"
    entrypoint: bash
    args:
      - -c
      - |
        set -euo pipefail
        python -m pip install --upgrade pip
        pip install "poetry==${_POETRY_VERSION}"
        poetry install --no-ansi

        echo "==> pre-commit"
        poetry run pre-commit run --all-files --show-diff-on-failure

        echo "==> unit tests"
        poetry run pytest -q

        echo "==> KFP compile"
        mkdir -p artifacts
        poetry run python -m {{ package_name }}.pipelines.training artifacts/training_pipeline.yaml
        poetry run python -m {{ package_name }}.pipelines.prediction artifacts/prediction_pipeline.yaml
        test -s artifacts/training_pipeline.yaml
        test -s artifacts/prediction_pipeline.yaml
        echo "Compiled KFP artifacts OK"

timeout: 1200s
