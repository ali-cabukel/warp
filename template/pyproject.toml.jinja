[tool.poetry]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_description }}"
authors = ["{{ author_name }} <{{ author_email }}>"]
readme = "README.md"
license = "{{ license }}"
keywords = ["vertex-ai", "kfp", "bqml", "ml-pipeline", "classification"]
packages = [{ include = "{{ package_name }}", from = "src" }]

[tool.poetry.dependencies]
python = "^{{ python_version }}"
kfp = ">=2.7"
google-cloud-aiplatform = ">=1.60"
google-cloud-bigquery = ">=3.25"
google-cloud-storage = ">=2.17"
pandas = ">=2.2"
numpy = ">=1.26"
pydantic = ">=2.7"
python-dotenv = ">=1.0"
fastapi = ">=0.111"
uvicorn = { extras = ["standard"], version = ">=0.30" }

[tool.poetry.group.dev.dependencies]
pytest = ">=8.2"
pytest-cov = ">=5.0"
httpx = ">=0.27"
ruff = ">=0.5"
mypy = ">=1.10"
pre-commit = ">=3.7"
types-requests = ">=2.32"

[tool.poetry.scripts]
{{ project_slug }}-trigger = "{{ package_name }}.trigger.submit:main"

[build-system]
requires = ["poetry-core>=1.9.0"]
build-backend = "poetry.core.masonry.api"

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.mypy]
python_version = "{{ python_version }}"
strict = false
ignore_missing_imports = true
packages = ["{{ package_name }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]
